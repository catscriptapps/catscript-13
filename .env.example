# CatScript-13 — copy this file to .env and fill it in (.env is never committed).

# --- App -------------------------------------------------------------------
APP_NAME="CatScript-13"
# Public URL, used in emailed links (password resets)
APP_URL=http://localhost:8013
# Sub-folder the site lives under, e.g. "my-app" for https://example.com/my-app/
# Leave blank when the site is at the domain root.
APP_BASE_PATH=

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=catscript_db
DB_USER=root
DB_PASSWORD=

# --- Install / DB reset ------------------------------------------------------
# ADMIN_RESET=true locks the whole site into maintenance mode: every page shows
# the "Reset Mode Active" screen, and the trash icon in its header runs the
# database migrations (scripts/migrations/) after asking for
# ADMIN_RESET_PASSWORD. On an empty database that's the full install; on a
# live one it only adds missing tables/columns — existing data is never
# dropped. Set it back to false when you're done.
ADMIN_RESET=false
ADMIN_RESET_PASSWORD=

# The first admin account (user #1), created by the DB reset only when the
# users table is empty. Leave ADMIN_PASSWORD blank to have a random one
# generated and shown once in the reset log. Remove the password from here
# after the install — change it in Settings once signed in.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Outgoing email (Src\Service\MailService) --------------------------------
# Password-reset links and replies from the Messages inbox. Leave MAIL_HOST
# blank to fall back to a bare localhost:25 relay with no auth (fine for local
# dev) — production needs real SMTP credentials or those emails won't send
# (failures are logged, not fatal).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="CatScript-13"

# --- Live chat AI autorespond (Src\Service\ChatAutoResponder) ----------------
# Leave blank to keep the Autorespond toggle disabled until you add a key.
ANTHROPIC_API_KEY=
